<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Test Plan - NAWI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="stylesheet" href="/css/pages/new-test.css">
</head>

<body>
    <div class="app-wrapper">
        <%- include('partials/sidebar') %>

            <div class="app-main">
                <%- include('partials/header') %>

                    <div class="app-content">
                        <div class="page-header">
                            <h2>Automatic Test Planner</h2>
                            <p>Generate a standards-driven test plan from your instrument specifications.</p>
                        </div>

                        <div class="form-card">
                            <h3>New Test Plan</h3>

                            <form id="initial-form">

                                <div class="form-group">
                                    <label>Instrument Type</label>
                                    <select name="instrument_type" class="form-input" required>
                                        <option value="platform">Platform Scale</option>
                                        <option value="analytical">Analytical Balance</option>
                                        <option value="crane">Crane / Hanging Scale</option>
                                        <option value="mobile">Mobile / Portable Scale</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Accuracy Class</label>
                                    <select name="Class_value" id="ClassValue" class="form-input" required>
                                        <option value="class I">Class I (laboratory machine )</option>
                                        <option value="class II">Class II (special accuracy machine )</option>
                                        <option value="class III" selected>Class III (commercial machine)</option>
                                        <option value="class IIII">Class IIII (weighing scale machine )</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Max Capacity</label>
                                    <div class="form-input-group">
                                        <input type="number" step="any" id="maxCapacity" name="capacity"
                                            placeholder="1000" required>
                                        <select name="max_unit">
                                            <option value="kg">kg</option>
                                            <option value="g">g</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Min Capacity</label>
                                    <div class="form-input-group">
                                        <input type="number" step="any" id="minCapacity" name="min_capacity"
                                            placeholder="20">
                                        <select name="min_unit">
                                            <option value="g">g</option>
                                            <option value="kg">kg</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Verification Scale</label>
                                    <div class="form-input-group">
                                        <input type="number" step="any" id="eValue" name="e_value" placeholder="10"
                                            required>
                                        <select name="e_unit">
                                            <option value="g">g</option>
                                            <option value="mg">mg</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Machine Make</label>
                                    <input type="text" name="manufacturer" placeholder="e.g. XYZ Scales"
                                        class="form-input" required>
                                </div>

                                <div class="form-group">
                                    <label>Model Name</label>
                                    <input type="text" name="model" placeholder="e.g. Model-A" class="form-input"
                                        required>
                                </div>

                                <!-- Hidden metadata fields to satisfy existing schema -->
                                <input type="hidden" name="serial" value="Unknown">
                                <input type="hidden" name="temperature" value="20">
                                <input type="hidden" name="humidity" value="50">
                                <input type="hidden" name="voltage" value="220">

                                <div class="form-actions">
                                    <button type="button" class="btn-submit" onclick="proceed()">Continue
                                        &rarr;</button>
                                </div>
                            </form>
                        </div>
                    </div>
            </div>
    </div>

    <script src="/r76engine.js"></script>
    <script src="script.js"></script>
</body>

</html>