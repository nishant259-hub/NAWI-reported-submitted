<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Test Plan - NAWI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="stylesheet" href="/css/pages/new-test.css">
</head>

<body>
    <div class="app-wrapper">
        <%- include('partials/sidebar') %>

            <div class="app-main">
                <%- include('partials/header') %>

                    <div class="app-content">
                        <div class="page-header">
                            <h2>Automatic Test Planner</h2>
                            <p>Generate a standards-driven test plan from your instrument specifications.</p>
                            
                            <!-- Display Active Rule Set -->
                            <div id="active-rule-banner" style="margin-top: 14px; padding: 12px 18px; background: #f0fdfa; border: 1.5px solid var(--brand); border-radius: 8px; display: none;">
                                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <span style="background:var(--brand); color:white; font-size:0.75rem; font-weight:700; padding:3px 10px; border-radius:12px; letter-spacing:0.5px;">
                                            <i class="fas fa-check-circle"></i> ACTIVE RULE SET
                                        </span>
                                        <span style="font-weight:700; color:var(--brand-dark); font-size:0.95rem;" id="rule-set-name">OIML R-76 V1</span>
                                    </div>
                                    <span style="font-size:0.8rem; color:#0f766e; font-weight:500;">
                                        Governing MPE, Repeatability, Tare & Eccentricity for this test
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="form-card">
                            <h3>1. Instrument Specifications</h3>

                            <form id="initial-form">
                                <input type="hidden" id="rule_set_version" name="rule_set_version" value="OIML R-76 V1">

                                <div class="form-group">
                                    <label>Instrument Type</label>
                                    <select name="instrument_type" class="form-input" required>
                                        <option value="platform">Platform Scale</option>
                                        <option value="analytical">Analytical Balance</option>
                                        <option value="crane">Crane / Hanging Scale</option>
                                        <option value="mobile">Mobile / Portable Scale</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Accuracy Class</label>
                                    <select name="Class_value" id="ClassValue" class="form-input" required>
                                        <option value="class I">Class I (laboratory machine )</option>
                                        <option value="class II">Class II (special accuracy machine )</option>
                                        <option value="class III" selected>Class III (commercial machine)</option>
                                        <option value="class IIII">Class IIII (weighing scale machine )</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Max Capacity</label>
                                    <div class="form-input-group">
                                        <input type="number" step="any" id="maxCapacity" name="capacity"
                                            placeholder="1000" required>
                                        <select name="max_unit">
                                            <option value="kg">kg</option>
                                            <option value="g">g</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Min Capacity</label>
                                    <div class="form-input-group">
                                        <input type="number" step="any" id="minCapacity" name="min_capacity"
                                            placeholder="20">
                                        <select name="min_unit">
                                            <option value="g">g</option>
                                            <option value="kg">kg</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Verification Scale</label>
                                    <div class="form-input-group">
                                        <input type="number" step="any" id="eValue" name="e_value" placeholder="10"
                                            required>
                                        <select name="e_unit">
                                            <option value="g">g</option>
                                            <option value="mg">mg</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Machine Make</label>
                                    <input type="text" name="manufacturer" placeholder="e.g. XYZ Scales"
                                        class="form-input" required>
                                </div>

                                <div class="form-group">
                                    <label>Model Name</label>
                                    <input type="text" name="model" placeholder="e.g. Model-A" class="form-input"
                                        required>
                                </div>

                                <div class="form-group">
                                    <label>Serial No.</label>
                                    <input type="text" name="serial_no" placeholder="e.g. SN-987654321" class="form-input"
                                        required>
                                </div>

                                <div class="form-group">
                                    <label>Instrument Photo (Optional)</label>
                                    <input type="file" id="instrument_photo" accept="image/*" class="form-input">
                                </div>

                                <h3 style="margin-top: 30px; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">2. Laboratory Details</h3>
                                
                                <div class="form-group">
                                    <label>Laboratory Name</label>
                                    <input type="text" name="lab_name" placeholder="e.g. National Metrology Lab" class="form-input" required>
                                </div>
                                <div class="form-group">
                                    <label>Location / State</label>
                                    <input type="text" name="lab_location" placeholder="e.g. New Delhi, Delhi" class="form-input" required>
                                </div>
                                <div class="form-group">
                                    <label>Testing Environment</label>
                                    <div style="display: flex; gap: 10px;">
                                        <input type="number" name="temperature" placeholder="Temp °C" class="form-input" value="20" required>
                                        <input type="number" name="humidity" placeholder="Humidity %" class="form-input" value="50" required>
                                        <input type="number" name="voltage" placeholder="Voltage V" class="form-input" value="220" required>
                                    </div>
                                </div>

                                <div class="form-actions" style="margin-top: 30px;">
                                    <button type="button" class="btn-submit" onclick="proceed()">Continue
                                        &rarr;</button>
                                </div>
                            </form>
                        </div>
                    </div>
            </div>
    </div>

    <script src="/r76engine.js"></script>
    <script src="script.js"></script>
    <script>
        // Fetch active rule set on page load
        fetch('/api/rules/active')
            .then(res => res.json())
            .then(data => {
                if(data && data.version_name) {
                    document.getElementById('active-rule-banner').style.display = 'block';
                    document.getElementById('rule-set-name').innerText = data.version_name;
                    document.getElementById('rule_set_version').value = data.version_name;
                    // Stash rules in global window object for r76engine to pick up
                    window.ACTIVE_OIML_RULES = data.rules;
                }
            })
            .catch(err => console.error("Failed to fetch rule set:", err));
    </script>
</body>

</html>