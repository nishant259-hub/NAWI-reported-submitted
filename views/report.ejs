<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report TP-<%= report._id.toString().substring(0,8).toUpperCase() %> - NAWI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="stylesheet" href="/css/pages/report.css">
</head>

<body>
    <div class="app-wrapper">
        <%- include('partials/sidebar') %>
        <div class="app-main">
            <%- include('partials/header') %>
            <div class="app-content">
                <div class="report-page">
                    
                    <div class="report-card" id="printable-report">
                        <div class="report-header">
                            <h2>TEST RESULTS</h2>
                            <div class="report-id">TP-<%= report._id.toString().substring(0,8).toUpperCase() %></div>
                        </div>

                        <div class="report-instrument">
                            <h3>Instrument: <%= report.instrument_id || "Unknown" %></h3>
                            <div class="inst-details">
                                <span><strong>Class:</strong> <%= (report.instrument_data && report.instrument_data.Class_value) ? report.instrument_data.Class_value : "N/A" %></span>
                                <span><strong>Max:</strong> <%= (report.instrument_data && report.instrument_data.capacity) ? report.instrument_data.capacity : "N/A" %> kg</span>
                                <span><strong>e:</strong> <%= (report.instrument_data && report.instrument_data.e_value) ? report.instrument_data.e_value : "N/A" %> g</span>
                            </div>
                        </div>

                        <div class="test-list-header">TEST RESULTS</div>

                        <% if (testStatus.visual) { %>
                            <div class="test-row">
                                <div class="test-info">
                                    <h4>Visual Inspection</h4>
                                    <p>Markings and conditions verified</p>
                                </div>
                                <div class="test-status <%= testStatus.visual === 'PASS' ? 'pass-text' : 'fail-text' %>">
                                    <i class="fas <%= testStatus.visual === 'PASS' ? 'fa-check' : 'fa-times' %>"></i> <%= testStatus.visual %>
                                </div>
                            </div>
                        <% } %>

                        <% if (testStatus.weighing) { %>
                            <div class="test-row">
                                <div class="test-info">
                                    <h4>Weighing Performance</h4>
                                    <p>Load observations against MPE</p>
                                </div>
                                <div class="test-status <%= testStatus.weighing === 'PASS' ? 'pass-text' : 'fail-text' %>">
                                    <i class="fas <%= testStatus.weighing === 'PASS' ? 'fa-check' : 'fa-times' %>"></i> <%= testStatus.weighing %>
                                </div>
                            </div>
                        <% } %>

                        <% if (testStatus.repeatability) { %>
                            <div class="test-row">
                                <div class="test-info">
                                    <h4>Repeatability</h4>
                                    <p>Variation within permissible limits</p>
                                </div>
                                <div class="test-status <%= testStatus.repeatability === 'PASS' ? 'pass-text' : 'fail-text' %>">
                                    <i class="fas <%= testStatus.repeatability === 'PASS' ? 'fa-check' : 'fa-times' %>"></i> <%= testStatus.repeatability %>
                                </div>
                            </div>
                        <% } %>

                        <% if (testStatus.eccentricity) { %>
                            <div class="test-row">
                                <div class="test-info">
                                    <h4>Eccentricity</h4>
                                    <p>Off-center loading errors</p>
                                </div>
                                <div class="test-status <%= testStatus.eccentricity === 'PASS' ? 'pass-text' : 'fail-text' %>">
                                    <i class="fas <%= testStatus.eccentricity === 'PASS' ? 'fa-check' : 'fa-times' %>"></i> <%= testStatus.eccentricity %>
                                </div>
                            </div>
                        <% } %>

                        <% if (testStatus.zero) { %>
                            <div class="test-row">
                                <div class="test-info">
                                    <h4>Zero Test</h4>
                                    <p>Zero-setting accuracy</p>
                                </div>
                                <div class="test-status <%= testStatus.zero === 'PASS' ? 'pass-text' : 'fail-text' %>">
                                    <i class="fas <%= testStatus.zero === 'PASS' ? 'fa-check' : 'fa-times' %>"></i> <%= testStatus.zero %>
                                </div>
                            </div>
                        <% } %>

                        <% if (testStatus.tare) { %>
                            <div class="test-row">
                                <div class="test-info">
                                    <h4>Tare Accuracy</h4>
                                    <p>Net weight accuracy</p>
                                </div>
                                <div class="test-status <%= testStatus.tare === 'PASS' ? 'pass-text' : 'fail-text' %>">
                                    <i class="fas <%= testStatus.tare === 'PASS' ? 'fa-check' : 'fa-times' %>"></i> <%= testStatus.tare %>
                                </div>
                            </div>
                        <% } %>

                        <% if (testStatus.tilt) { %>
                            <div class="test-row">
                                <div class="test-info">
                                    <h4>Tilt Test</h4>
                                    <p>Leveling variation</p>
                                </div>
                                <div class="test-status <%= testStatus.tilt === 'PASS' ? 'pass-text' : 'fail-text' %>">
                                    <i class="fas <%= testStatus.tilt === 'PASS' ? 'fa-check' : 'fa-times' %>"></i> <%= testStatus.tilt %>
                                </div>
                            </div>
                        <% } %>

                        <div class="overall-result">
                            <h4>OVERALL RESULT</h4>
                            <div class="result-badge <%= overallPass ? 'result-pass' : 'result-fail' %>">
                                <%= overallPass ? '✓ PASS' : '❌ FAIL' %>
                            </div>
                            <div class="result-stats">
                                <div><%= passCount %> / <%= totalTests %> tests passed</div>
                                <% if (failCount > 0) { %>
                                    <div style="color: #e74c3c; margin-top: 4px;"><%= failCount %> test(s) failed</div>
                                <% } %>
                            </div>
                        </div>

                        <div class="action-footer">
                            <a href="/report-detailed?id=<%= report._id %>"><button class="btn btn-secondary"><i class="fas fa-list"></i> View Detailed Results</button></a>
                            <button class="btn" style="background:#0E7C86;" onclick="window.print()"><i class="fas fa-file-pdf"></i> Generate Report</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>