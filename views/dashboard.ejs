<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <img src="/images/logo.jpg" alt="Bytebrigade Logo">
            Bytebrigade
        </a>
        <div class="navbar-links">
            <a href="/"><i class="fas fa-home"></i> Home</a>
            <a href="/new-test"><i class="fas fa-play"></i> New Test</a>
            <a href="/dashboard"><i class="fas fa-folder-open"></i> Dashboard</a>
        </div>
    </nav>
    <div class="container">

        <h1><i class="fas fa-folder-open"></i> Previous NAWI Test Reports</h1>

        <a href="/new-test" class="btn btn-success"><i class="fas fa-plus"></i> Create New Report</a>

        <table>
            <thead>
                <tr>
                    <th>Date / Time</th>
                    <th>Machine Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (reports.length> 0) { %>
                    <% reports.forEach(report=> { %>
                        <tr>
                            <td>
                                <%= new Date(report.createdAt).toLocaleString() %>
                            </td>
                            <td>
                                <%= report.instrument_data && report.instrument_data.manufacturer ? report.instrument_data.manufacturer + ' ' + report.instrument_data.model : "Unknown" %>
                            </td>
                            <td><a href="/report?id=<%= report._id %>" class="btn"><i class="fas fa-eye"></i> View
                                    Report</a></td>
                        </tr>
                        <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="no-data">No reports found in the database.</td>
                                </tr>
                                <% } %>
            </tbody>
        </table>
    </div>
</body>

</html>