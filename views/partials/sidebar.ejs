<aside class="app-sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon"><i class="fas fa-balance-scale-right"></i></div>
        <div class="brand-text">NAWI <span>REPORTED</span></div>
    </div>
    <div class="sidebar-nav">
        <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
            <!-- ADMIN NAV -->
            <a href="/admin" class="nav-item"><i class="fas fa-user-shield"></i> <span>Admin Dashboard</span></a>
            <a href="/history" class="nav-item"><i class="fas fa-history"></i> <span>All Reports</span></a>
        <% } else { %>
            <!-- TESTER NAV -->
            <a href="/home" class="nav-item"><i class="fas fa-th-large"></i> <span>Dashboard</span></a>
            <a href="/new-test" class="nav-item"><i class="fas fa-plus"></i> <span>New Test</span></a>
            <a href="/test-plan" class="nav-item" id="nav-test-plan"><i class="fas fa-clipboard-list"></i> <span id="lbl-test-plan">Test Planner</span></a>
            <a href="/tests" class="nav-item" id="nav-tests"><i class="fas fa-flask"></i> <span id="lbl-tests">Test Execution</span></a>
            <a href="/history" class="nav-item"><i class="fas fa-history"></i> <span>History</span></a>
        <% } %>
    </div>

    <!-- User info + Logout at bottom -->
    <div class="sidebar-user">
        <div class="sidebar-user-info">
            <div class="sidebar-avatar">
                <%= (typeof username !== 'undefined' && username) ? username.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div>
                <div class="sidebar-username"><%= (typeof username !== 'undefined' && username) ? username : 'User' %></div>
                <div class="sidebar-role"><%= (typeof userRole !== 'undefined' && userRole === 'admin') ? 'Administrator' : 'Tester' %></div>
            </div>
        </div>
        <a href="/logout" class="sidebar-logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
</aside>

<style>
    .sidebar-user {
        padding: 16px;
        border-top: 1px solid rgba(255,255,255,0.06);
        margin-top: auto;
    }
    .sidebar-user-info {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }
    .sidebar-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand, #0d9488), #7c3aed);
        display: grid;
        place-items: center;
        color: white;
        font-weight: 700;
        font-size: 0.875rem;
        flex-shrink: 0;
    }
    .sidebar-username {
        color: white;
        font-size: 0.875rem;
        font-weight: 600;
    }
    .sidebar-role {
        color: #94a3b8;
        font-size: 0.72rem;
    }
    .sidebar-logout {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #f87171;
        font-size: 0.82rem;
        font-weight: 500;
        text-decoration: none;
        padding: 8px 10px;
        border-radius: 6px;
        transition: background 0.15s;
        width: 100%;
    }
    .sidebar-logout:hover {
        background: rgba(239, 68, 68, 0.1);
        color: #fca5a5;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const path = window.location.pathname;
        const navItems = document.querySelectorAll(".sidebar-nav .nav-item");
        navItems.forEach(item => {
            if (item.getAttribute("href") === path) {
                item.classList.add("active");
            } else {
                item.classList.remove("active");
            }
        });
        
        // Handle Planner and Execution links if no test is active
        const planBtn = document.getElementById("nav-test-plan");
        const testBtn = document.getElementById("nav-tests");
        const lblPlan = document.getElementById("lbl-test-plan");
        const lblTest = document.getElementById("lbl-tests");

        function showToast(message) {
            let toast = document.getElementById("global-toast");
            if (!toast) {
                toast = document.createElement("div");
                toast.id = "global-toast";
                toast.innerHTML = `
                    <div style="color: #e74c3c; font-size: 22px;"><i class="fas fa-exclamation-circle"></i></div>
                    <div id="toast-msg" style="color: #0B2A3B; font-family: 'IBM Plex Sans', sans-serif; font-weight: 500; font-size: 14px;"></div>
                `;
                Object.assign(toast.style, {
                    position: "fixed", bottom: "-100px", right: "32px", background: "#fff",
                    borderLeft: "4px solid #e74c3c", boxShadow: "0 4px 20px rgba(0,0,0,0.1)",
                    padding: "16px 24px", borderRadius: "8px", display: "flex", alignItems: "center",
                    gap: "16px", zIndex: "1000", transition: "bottom 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)"
                });
                document.body.appendChild(toast);
            }
            document.getElementById("toast-msg").textContent = message;
            
            // Trigger animation
            setTimeout(() => { toast.style.bottom = "32px"; }, 10);
            setTimeout(() => { toast.style.bottom = "-100px"; }, 4000);
        }

        if (!localStorage.getItem("InstrumentData")) {
            // No test active: allow click but show toast and block navigation
            const blockNav = function(e) {
                e.preventDefault();
                showToast("No active test session found. Please start a new test to proceed.");
            };
            if (planBtn) { planBtn.addEventListener("click", blockNav); }
            if (testBtn) { testBtn.addEventListener("click", blockNav); }
            
            // If they somehow land directly on the page, kick them back to new-test
            if (path === '/test-plan' || path === '/tests') {
                window.location.href = "/new-test";
            }
        } else {
            // There is an ongoing test session
            if (lblPlan && path !== '/test-plan') lblPlan.textContent = "Resume Planner";
            if (lblTest && path !== '/tests') lblTest.textContent = "Resume Execution";
        }
    });
</script>
